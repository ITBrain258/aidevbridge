{
  "name": "aidevbridge",
  "private": true,
  "version": "0.2.4",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITBrain258/aidevbridge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tauri build --no-bundle",
    "build:windows": "pwsh -NoProfile -File scripts/release-windows.ps1",
    "build:macos": "node scripts/release-macos-artifacts.mjs build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "tauri": "tauri",
    "bump": "node scripts/bump-version.mjs",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^29.1.1",
    "lucide-static": "1.41.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": false
  }
}
