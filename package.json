{
  "name": "aidevbridge",
  "private": true,
  "version": "0.2.6",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITBrain258/aidevbridge.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-dist-notices.mjs",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "build:app": "tauri build --no-bundle",
    "build:windows": "pwsh -NoProfile -File scripts/release-windows.ps1",
    "build:macos": "node scripts/release-macos-artifacts.mjs build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "licenses:status": "node scripts/release-license-status.mjs",
    "licenses:rebind-own": "node scripts/release-license-status.mjs --rebind-own",
    "licenses:check": "node scripts/release-license-status.mjs --check",
    "licenses:derive": "node scripts/release-license-select-macos.mjs --write && node scripts/release-license-select-android.mjs --write",
    "tauri": "tauri",
    "bump": "node scripts/bump-version.mjs",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "lucide-static": "1.69.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
