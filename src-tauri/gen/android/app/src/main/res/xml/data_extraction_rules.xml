<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 und neuer: nichts aus dem privaten Speicher verlaesst das
     Geraet, weder als Cloud-Sicherung noch beim Umzug auf ein neues Geraet
     (Spec 2026-10-27 §4.5). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
