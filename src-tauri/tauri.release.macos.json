{
  "build": {
    "beforeBuildCommand": "node scripts/release-macos-artifacts.mjs before-build",
    "beforeBundleCommand": "node scripts/release-macos-artifacts.mjs before-bundle"
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "resources": {
      "../out/release-notices-macos/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "12.4",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
